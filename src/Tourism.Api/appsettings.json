{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=tourism;User=tourism_dev;Password=tourism_dev;"
  },
  // Validates the end-user access tokens Platform issues. Issuer/Audience must match
  // Platform's own "Jwt:Issuer" / "Jwt:Audience" exactly — this is what lets BIT trust a
  // token it never issued.
  "Jwt": {
    "Issuer": "PimaPlatform",
    "Audience": "PimaPlatform.Clients",
    // Intentionally blank. Provide via the Jwt__SigningKey environment variable or
    // user-secrets — never commit a real signing key here. Must be at least 32 characters
    // and identical to Platform's own signing key; the app fails to start otherwise (see
    // Tourism.Infrastructure.Security.JwtOptions / AddInfrastructure).
    "SigningKey": ""
  },
  // How BIT authenticates itself to Platform to request a service token for calling PIMA.
  "Platform": {
    "BaseUrl": "https://localhost:7061",
    "ClientId": "TourismCore",
    // Intentionally blank. Provide via the Platform__ClientSecret environment variable or
    // user-secrets — never commit a real client secret here.
    "ClientSecret": ""
  },
  // Where the identity engine lives, and which audience BIT must request a service token
  // for before calling it (must match one of PIMA's own registered audiences and PIMA's
  // "Jwt:Audience").
  "Pima": {
    "BaseUrl": "https://localhost:7204",
    "Audience": "PimaCore.Services",
    "TimeoutSeconds": 10
  }
}
